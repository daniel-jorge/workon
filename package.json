{
  "name": "@crize2013/workon",
  "version": "1.0.0-alpha.0",
  "description": "Find and open your projects quickly",
  "bin": {
    "workon": "./dist/cli.mjs"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "lint": "oxlint .",
    "format": "oxfmt --write src tests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "commander": "14.0.3",
    "fast-glob": "3.3.3",
    "fuse.js": "7.3.0",
    "ink": "7.0.1",
    "react": "19.2.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "ink-testing-library": "4.0.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "tsdown": "0.21.9",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=18"
  }
}
